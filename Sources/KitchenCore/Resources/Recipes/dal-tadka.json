      "setting": { "heat": 100, "speed": 1, "reverse": true, "seconds": 2100 } },
    { "id": "s6", "phase": "Umfüllen", "text": "Dal in eine Servierschüssel füllen und warm halten. Topf ausspülen und abtrocknen." },
